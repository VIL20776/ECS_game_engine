#pragma once

#include "system_runtime.hpp"
#include "world.hpp"

#include <expected>
#include <string_view>

namespace ecs::game {
enum class Error {
    SDLInitializationFailed,
    WindowCreationFailed,
    GPUInitFailed,
    ComponentLoadFailed,
    SystemLoadFailed,
};
}

class Game {
public:
    Game();

    [[nodiscard]] std::expected<int, ecs::game::Error> setup(std::string_view component_file, std::string_view systems_file);
    [[nodiscard]] int start() noexcept;
    [[nodiscard]] int input(SDL_Event* event, double delta_time);
    [[nodiscard]] int update(double delta_time);
    [[nodiscard]] int stop() noexcept;
    [[nodiscard]] int quit() noexcept;
    [[nodiscard]] bool isRunning() const noexcept;

private:
    ecs::World world;
    ecs::lua::SystemRuntime systems;
    bool is_running{false};
};
